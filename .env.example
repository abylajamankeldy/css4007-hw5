# Copy to .env (never commit .env). Part 1 and the tests need no key.
#
# Any OpenAI-compatible, tool-calling chat model works.
# Option A - OpenAI:
#   OPENAI_API_KEY=sk-...
#   MODEL_NAME=gpt-5.6-luna            (any tool-capable model your account has)
#   OPENAI_BASE_URL=                   (leave empty)
# Option B - Groq (free key at console.groq.com), OpenAI-compatible endpoint:
#   OPENAI_API_KEY=gsk_...
#   MODEL_NAME=openai/gpt-oss-120b
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
MODEL_NAME=
OPENAI_BASE_URL=
# Where conversation and user memory are saved (ignored by git).
HELPDESK_STORAGE_DIR=local-storage
# Keep external tracing disabled for this local exercise.
LANGSMITH_TRACING=false
